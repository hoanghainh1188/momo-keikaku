{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node"
    ],
    "paths": {
      "@momo/domain": [
        "./packages/domain/src/index.ts"
      ],
      "@momo/domain/*": [
        "./packages/domain/src/*"
      ],
      "@momo/db": [
        "./packages/db/src/index.ts"
      ],
      "@momo/db/*": [
        "./packages/db/src/*"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.ts",
    "drizzle.config.ts"
  ],
  "exclude": [
    "node_modules",
    "apps"
  ]
}