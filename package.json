{
  "name": "momo-keikaku",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "demo": "tsx scripts/demo.ts",
    "db:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "db:reset": "tsx packages/db/src/reset.ts",
    "seed": "tsx packages/db/src/seed.ts",
    "dev": "pnpm --filter @momo/web dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json --pretty false"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0",
    "uuid": "^11.0.3"
  },
  "type": "module"
}
