# Local-only profile (AD-17 / story 1.8). Next loads this for every `next dev`
# (`pnpm dev` and `pnpm demo`). Never set DEPLOYMENT=local in a deployment template.
#
# Connection strings and SEED_DEMO_PASSWORD are NOT here — they come from the shell
# (or `apps/web/.env.local`, gitignored). `pnpm seed` loads this file via `--env-file`
# for DEPLOYMENT / CLOCK_MODE only; DATABASE_URL / APP_DATABASE_URL / SEED_DEMO_PASSWORD
# must already be in the environment (docker-compose defaults: localhost:55433).
DEPLOYMENT=local
CLOCK_MODE=fixture
FIXTURE_TIME_ANCHOR=2026-09-16T09:00:00.000Z
TRACKER_ADAPTER_OVERRIDE=fixture
MAILER=console
